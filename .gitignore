# Python
__pycache__/
*.pyc
.venv/

# Tool caches
.ruff_cache/
.pytest_cache/
.ty_cache/

# Secrets / env (only .streamlit/secrets.toml is ignored — the tracked
# .streamlit/config.toml holds the dark theme and must stay committed)
# `.env*` (not bare `.env`) so .env.local / .env.production / .envrc are covered
# too, and this list stays in sync with the permissions.deny rules in
# .claude/settings.json — those block Claude from touching such a file, which
# reads as "protected" and makes a git-committable one especially dangerous.
.env*
.streamlit/secrets.toml

# OS / local
.DS_Store
.worktrees/

# docs/ holds README image assets; track images, ignore other scratch content.
# (Ignore contents, not the dir, so specific paths can be negated — git can't
# re-include a file whose parent directory is excluded.)
docs/*
!docs/*.png

# Claude Code: share team hooks + project settings, keep personal settings local.
# Ignore the directory *contents* (not the dir) so specific paths can be negated —
# git can't re-include a file whose parent directory is excluded.
.claude/*
!.claude/settings.json
!.claude/hooks/
